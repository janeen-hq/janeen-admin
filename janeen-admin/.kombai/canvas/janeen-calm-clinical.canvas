      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');\n  .janeen-shell { font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif; }\n  .janeen-shell button:focus-visible,\n  .janeen-shell a:focus-visible,\n  .janeen-shell input:focus-visible,\n  .janeen-shell select:focus-visible { outline: 3px solid #90A88A; outline-offset: 2px; }\n  .janeen-row:hover { background: #F4F0E8; }\n  .janeen-row:hover .janeen-row-action { opacity: 1; }\n  .janeen-nav-item:hover { color: #F7F4EE; background: rgba(217,226,219,.1); }\n  .janeen-tab:hover { color: #142126; }\n  @media (max-width: 767px) {\n    .janeen-sidebar { position: relative; width: 100%; min-height: auto; }\n    .janeen-sidebar-scroll { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 18px; max-height: none; }\n    .janeen-content { min-width: 0; }\n    .janeen-desktop-table { display: none; }\n    .janeen-mobile-list { display: block; }\n  }\n  @media (min-width: 768px) {\n    .janeen-mobile-list { display: none; }\n  }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"janeen-shell min-h-screen bg-[#F7F4EE] text-[#142126] antialiased\" data-kid=\"1\" data-name=\"admin workspace shell\">\n    <div class=\"flex min-h-screen flex-col md:flex-row\" data-kid=\"1-1\" data-name=\"sidebar and main content wrapper\">\n        <aside aria-label=\"Janeen admin navigation\" class=\"janeen-sidebar flex w-full shrink-0 flex-col bg-[#142126] text-[#D9E2DB] md:sticky md:top-0 md:h-screen md:w-[238px]\" data-kid=\"1-1-1\" data-name=\"sidebar navigation\">\n            <div class=\"flex items-center gap-3 border-b border-white/10 px-5 py-5\" data-kid=\"1-1-1-1\" data-name=\"workspace branding container\">\n                <div aria-hidden=\"true\" class=\"flex h-9 w-9 items-center justify-center rounded-md bg-[#90A88A] text-lg font-bold text-[#142126]\" data-kid=\"1-1-1-1-1\" data-name=\"workspace initial\">\n                    J\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"branding text\">\n                    <p class=\"text-[15px] font-bold tracking-[.08em] text-[#F7F4EE]\" data-kid=\"1-1-1-1-2-1\" data-name=\"workspace name\">\n                        JANEEN\n                    </p>\n                    <p class=\"mt-0.5 text-[10px] uppercase tracking-[.16em] text-[#90A88A]\" data-kid=\"1-1-1-1-2-2\" data-name=\"workspace type\">\n                        Admin workspace\n                    </p>\n                </div>\n            </div>\n            <div class=\"janeen-sidebar-scroll flex-1 overflow-y-auto px-3 py-4 md:space-y-5\" data-kid=\"1-1-1-2\" data-name=\"scrollable sidebar navigation area\">\n                <section data-kid=\"1-1-1-2-1\" data-name=\"navigation group dashboard\">\n                    <p class=\"mb-2 px-3 text-[10px] font-bold uppercase tracking-[.18em] text-[#90A88A]\" data-kid=\"1-1-1-2-1-1\" data-name=\"navigation group label dashboard\">\n                        Dashboard\n                    </p>\n                    <a aria-current=\"page\" class=\"janeen-nav-item flex items-center gap-3 rounded-md border-l-2 border-[#90A88A] bg-[#90A88A]/15 px-3 py-2.5 text-[13px] font-semibold text-[#F7F4EE]\" data-kid=\"1-1-1-2-1-2\" data-name=\"navigation link dashboard\" data-route=\"/\" href=\"#dashboard\">\n                        <i class=\"h-4 w-4 shrink-0\" data-kid=\"1-1-1-2-1-2-1\" data-lucide=\"layout-dashboard\" data-name=\"layout dashboard icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-1-2-2\" data-name=\"navigation link label dashboard\">\n                            Dashboard\n                        </span>\n                    </a>\n                </section>\n                <section data-kid=\"1-1-1-2-2\" data-name=\"navigation group notifications\">\n                    <p class=\"mb-2 px-3 text-[10px] font-bold uppercase tracking-[.18em] text-[#90A88A]\" data-kid=\"1-1-1-2-2-1\" data-name=\"navigation group label notifications\">\n                        Notifications\n                    </p>\n                    <div class=\"space-y-1\" data-kid=\"1-1-1-2-2-2\" data-name=\"nested navigation links container\">\n                        <a class=\"janeen-nav-item flex items-center gap-3 rounded-md px-3 py-2 text-[13px] text-[#B8C8BF]\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"navigation link new notification\" data-route=\"/notifications/new\" href=\"#notifications\">\n                            <i class=\"h-4 w-4 shrink-0\" data-kid=\"1-1-1-2-2-2-1-1\" data-lucide=\"bell\" data-name=\"bell icon\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-2-2-1-2\" data-name=\"navigation link label new notification\">\n                                Notifications\n                            </span>\n                        </a>\n                        <a class=\"janeen-nav-item flex items-center gap-3 rounded-md px-3 py-2 text-[13px] text-[#B8C8BF]\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"navigation link create notification\" data-route=\"/notifications/create\" href=\"#create-notification\">\n                            <i class=\"h-4 w-4 shrink-0\" data-kid=\"1-1-1-2-2-2-2-1\" data-lucide=\"bell-plus\" data-name=\"bell plus icon\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-2-2-2-2\" data-name=\"navigation link label create notification\">\n                                Create notification\n                            </span>\n                        </a>\n                    </div>\n                </section>\n                <section data-kid=\"1-1-1-2-3\" data-name=\"navigation group blogs\">\n                    <p class=\"mb-2 px-3 text-[10px] font-bold uppercase tracking-[.18em] text-[#90A88A]\" data-kid=\"1-1-1-2-3-1\" data-name=\"navigation group label blogs\">\n                        Blogs\n                    </p>\n                    <a class=\"janeen-nav-item flex items-center gap-3 rounded-md px-3 py-2 text-[13px] text-[#B8C8BF]\" data-kid=\"1-1-1-2-3-2\" data-name=\"navigation link blogs\" data-route=\"/blogs/blog\" href=\"#blogs\">\n                        <i class=\"h-4 w-4 shrink-0\" data-kid=\"1-1-1-2-3-2-1\" data-lucide=\"newspaper\" data-name=\"newspaper icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-3-2-2\" data-name=\"navigation link label blogs\">\n                            Blogs\n                        </span>\n                    </a>\n                </section>\n                <section data-kid=\"1-1-1-2-4\" data-name=\"navigation group cms\">\n                    <p class=\"mb-2 px-3 text-[10px] font-bold uppercase tracking-[.18em] text-[#90A88A]\" data-kid=\"1-1-1-2-4-1\" data-name=\"navigation group label cms\">\n                        CMS\n                    </p>\n                    <a aria-current=\"page\" class=\"janeen-nav-item flex items-center gap-3 rounded-md px-3 py-2 text-[13px] font-semibold text-[#F7F4EE]\" data-kid=\"1-1-1-2-4-2\" data-name=\"navigation link content\" data-route=\"content/contentStage\" href=\"#content\">\n                        <i class=\"h-4 w-4 shrink-0\" data-kid=\"1-1-1-2-4-2-1\" data-lucide=\"file-text\" data-name=\"file text icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-4-2-2\" data-name=\"navigation link label content\">\n                            Content\n                        </span>\n                    </a>\n                </section>\n                <section data-kid=\"1-1-1-2-5\" data-name=\"navigation group badges\">\n                    <p class=\"mb-2 px-3 text-[10px] font-bold uppercase tracking-[.18em] text-[#90A88A]\" data-kid=\"1-1-1-2-5-1\" data-name=\"navigation group label badges\">\n                        Badges\n                    </p>\n                    <a class=\"janeen-nav-item flex items-center gap-3 rounded-md px-3 py-2 text-[13px] text-[#B8C8BF]\" data-kid=\"1-1-1-2-5-2\" data-name=\"navigation link badge manager\" data-route=\"/badges/badge\" href=\"#badges\">\n                        <i class=\"h-4 w-4 shrink-0\" data-kid=\"1-1-1-2-5-2-1\" data-lucide=\"medal\" data-name=\"medal icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-5-2-2\" data-name=\"navigation link label badge manager\">\n                            Badge Manager\n                        </span>\n                    </a>\n                </section>\n                <section data-kid=\"1-1-1-2-6\" data-name=\"navigation group chat\">\n                    <p class=\"mb-2 px-3 text-[10px] font-bold uppercase tracking-[.18em] text-[#90A88A]\" data-kid=\"1-1-1-2-6-1\" data-name=\"navigation group label chat\">\n                        Chat\n                    </p>\n                    <a class=\"janeen-nav-item flex items-center gap-3 rounded-md px-3 py-2 text-[13px] text-[#B8C8BF]\" data-kid=\"1-1-1-2-6-2\" data-name=\"navigation link channels\" data-route=\"/chat/channels\" href=\"#channels\">\n                        <i class=\"h-4 w-4 shrink-0\" data-kid=\"1-1-1-2-6-2-1\" data-lucide=\"message-square\" data-name=\"message square icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-6-2-2\" data-name=\"navigation link label channels\">\n                            Channels\n                        </span>\n                        <span class=\"ml-auto rounded-full bg-[#D77A62] px-1.5 py-0.5 text-[10px] font-bold text-white\" data-dynamic=\"true\" data-kid=\"1-1-1-2-6-2-3\" data-name=\"unread channels count\" data-reason=\"count value updated by script\">\n                            4\n                        </span>\n                    </a>\n                </section>\n                <section data-kid=\"1-1-1-2-7\" data-name=\"navigation group courses\">\n                    <p class=\"mb-2 px-3 text-[10px] font-bold uppercase tracking-[.18em] text-[#90A88A]\" data-kid=\"1-1-1-2-7-1\" data-name=\"navigation group label courses\">\n                        Courses\n                    </p>\n                    <a class=\"janeen-nav-item flex items-center gap-3 rounded-md px-3 py-2 text-[13px] text-[#B8C8BF]\" data-kid=\"1-1-1-2-7-2\" data-name=\"navigation link courses\" data-route=\"/courses/list\" href=\"#courses\">\n                        <i class=\"h-4 w-4 shrink-0\" data-kid=\"1-1-1-2-7-2-1\" data-lucide=\"book-open\" data-name=\"book open icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-7-2-2\" data-name=\"navigation link label courses\">\n                            Courses\n                        </span>\n                    </a>\n                </section>\n            </div>\n            <div class=\"border-t border-white/10 px-4 py-4\" data-kid=\"1-1-1-3\" data-name=\"sidebar user account area\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-3-1\" data-name=\"user identity container\">\n                    <div class=\"flex h-8 w-8 items-center justify-center rounded-md bg-[#D9E2DB] text-xs font-bold text-[#142126]\" data-kid=\"1-1-1-3-1-1\" data-name=\"user avatar placeholder\">\n                        AD\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"1-1-1-3-1-2\" data-name=\"user info container\">\n                        <p class=\"truncate text-xs font-semibold text-[#F7F4EE]\" data-kid=\"1-1-1-3-1-2-1\" data-name=\"user name\">\n                            Admin account\n                        </p>\n                        <p class=\"truncate text-[11px] text-[#9EB0A7]\" data-kid=\"1-1-1-3-1-2-2\" data-name=\"user role\">\n                            Content operations\n                        </p>\n                    </div>\n                    <button aria-label=\"Logout\" class=\"ml-auto rounded-md p-1.5 text-[#9EB0A7] hover:bg-white/10 hover:text-white\" data-kid=\"1-1-1-3-1-3\" data-name=\"logout button\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-1-3-1-3-1\" data-lucide=\"log-out\" data-name=\"logout icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </aside>\n        <main class=\"janeen-content min-w-0 flex-1\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <header aria-label=\"Admin header\" class=\"flex min-h-[72px] items-center justify-between gap-4 border-b border-[#D9D7D0] bg-[#F7F4EE] px-5 py-3 md:px-8\" data-kid=\"1-1-2-1\" data-name=\"admin header\">\n                <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-2-1-1\" data-name=\"header breadcrumbs and nav toggle\">\n                    <button aria-label=\"Open navigation\" class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-[#D9D7D0] text-[#52645D] hover:border-[#90A88A] hover:text-[#142126] md:hidden\" data-kid=\"1-1-2-1-1-1\" data-name=\"mobile navigation toggle button\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-2-1-1-1-1\" data-lucide=\"menu\" data-name=\"menu icon\">\n                        </i>\n                    </button>\n                    <div class=\"hidden items-center gap-2 text-xs text-[#7E9188] sm:flex\" data-kid=\"1-1-2-1-1-2\" data-name=\"desktop breadcrumbs\">\n                        <span data-kid=\"1-1-2-1-1-2-1\" data-name=\"breadcrumb path root\">\n                            Janeen Admin\n                        </span>\n                        <i class=\"h-3 w-3\" data-kid=\"1-1-2-1-1-2-2\" data-lucide=\"chevron-right\" data-name=\"breadcrumb separator icon\">\n                        </i>\n                        <span class=\"font-semibold text-[#142126]\" data-kid=\"1-1-2-1-1-2-3\" data-name=\"breadcrumb current page\">\n                            Content workspace\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2 sm:gap-4\" data-kid=\"1-1-2-1-2\" data-name=\"header action bar\">\n                    <label class=\"relative hidden w-52 md:block lg:w-72\" data-kid=\"1-1-2-1-2-1\" data-name=\"search input field wrapper\">\n                        <span class=\"sr-only\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"search input sr label\">\n                            Search workspace\n                        </span>\n                        <i class=\"absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#7E9188]\" data-kid=\"1-1-2-1-2-1-2\" data-lucide=\"search\" data-name=\"search icon\">\n                        </i>\n                        <input class=\"h-10 w-full rounded-md border border-[#D9D7D0] bg-white/60 pl-9 pr-3 text-sm text-[#142126] placeholder:text-[#98A49F] focus:border-[#90A88A] focus:bg-white\" data-kid=\"1-1-2-1-2-1-3\" data-name=\"search input field\" placeholder=\"Search workspace\" type=\"search\"/>\n                    </label>\n                    <button aria-label=\"Notifications\" class=\"relative flex h-9 w-9 items-center justify-center rounded-md text-[#52645D] hover:bg-[#D9E2DB] hover:text-[#142126]\" data-kid=\"1-1-2-1-2-2\" data-name=\"notifications action button\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-2-1-2-2-1\" data-lucide=\"bell\" data-name=\"bell icon\">\n                        </i>\n                        <span class=\"absolute right-1.5 top-1.5 h-1.5 w-1.5 rounded-full bg-[#D77A62]\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"notifications unread indicator\">\n                        </span>\n                    </button>\n                    <div class=\"hidden text-right sm:block\" data-kid=\"1-1-2-1-2-3\" data-name=\"header user profile info\">\n                        <p class=\"text-xs font-semibold text-[#142126]\" data-kid=\"1-1-2-1-2-3-1\" data-name=\"header user name\">\n                            Admin\n                        </p>\n                        <p class=\"text-[11px] text-[#7E9188]\" data-kid=\"1-1-2-1-2-3-2\" data-name=\"header user role\">\n                            Administrator\n                        </p>\n                    </div>\n                    <img alt=\"Admin profile\" class=\"h-9 w-9 rounded-md object-cover\" data-kid=\"1-1-2-1-2-4\" data-name=\"header profile image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/profile-image.jpg\"/>\n                </div>\n            </header>\n            <div class=\"px-5 py-7 md:px-8 md:py-9\" data-kid=\"1-1-2-2\" data-name=\"main page content\">\n                <div class=\"mx-auto max-w-[1240px]\" data-kid=\"1-1-2-2-1\" data-name=\"content workspace container\">\n                    <div class=\"flex flex-col justify-between gap-5 border-b border-[#D9D7D0] pb-6 lg:flex-row lg:items-end\" data-kid=\"1-1-2-2-1-1\" data-name=\"page heading block\">\n                        <div data-kid=\"1-1-2-2-1-1-1\" data-name=\"heading text block\">\n                            <p class=\"mb-2 text-[11px] font-bold uppercase tracking-[.18em] text-[#7E9188]\" data-kid=\"1-1-2-2-1-1-1-1\" data-name=\"page breadcrumb\">\n                                CMS / Content\n                            </p>\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-2-1-1-1-2\" data-name=\"page title container\">\n                                <h1 class=\"text-[30px] font-semibold tracking-[-.03em] text-[#142126] md:text-[36px]\" data-kid=\"1-1-2-2-1-1-1-2-1\" data-name=\"page title\">\n                                    Content workspace\n                                </h1>\n                                <span class=\"rounded-sm bg-[#D9E2DB] px-2 py-1 text-[11px] font-bold text-[#42604D]\" data-kid=\"1-1-2-2-1-1-1-2-2\" data-name=\"live status badge\">\n                                    Live view\n                                </span>\n                            </div>\n                            <p c